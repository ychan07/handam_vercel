FIREBASE_WEB_API_KEY=
# Firebase Console > 프로젝트 설정 > 서비스 계정 > 새 비밀키 (JSON 전체를 한 줄로)
FIREBASE_SERVICE_ACCOUNT=
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin
ADMIN_JWT_SECRET=
# 비밀번호 재설정 링크 리다이렉트용 (예: https://your-app.vercel.app)
APP_PUBLIC_URL=
CLOVA_OCR_INVOKE_URL=
CLOVA_OCR_SECRET=
GEMINI_API_KEY=
# 선택 사항. 비워두면 gemini-2.5-flash 사용
GEMINI_MODEL=gemini-2.5-flash
# Example: https://api.example.com/fortune?birthday={birthday}
FORTUNE_API_URL=
PORT=4173
