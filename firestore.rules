rules_version = '2';

// ===============================================================
// Assumed Data Model
// ===============================================================
//
// Collection: users/{userId}
// Fields:
//   uid: string (required, immutable, must match userId)
//   email: string (required, 0..254 chars, private)
//   displayName: string (required, 1..80 chars, private)
//   settings: map (required, exact schema validated below)
//   migrationVersion: int (required, 0..1)
//   updatedAt: timestamp (required, server time)
//
// Subcollection: users/{userId}/diaries/{diaryId}
// Fields:
//   uid: string (required, immutable, must match userId)
//   title: string (required, 1..200 chars)
//   body: string (required, 1..200000 chars)
//   mood: string (required, 1..50 chars)
//   summary: string (required, 0..10000 chars)
//   entryDate: string (required, YYYY-MM-DD format)
//   createdAt: timestamp (required, immutable; may be historical during migration)
//   syncedAt: timestamp (required, server time)
//   updatedAt: timestamp (required, server time)
//
// All other document paths are denied to browser clients. Firebase Admin SDK
// operations are controlled by IAM and bypass these client Security Rules.
// ===============================================================

service cloud.firestore {
  match /databases/{database}/documents {
    // =============================================================
    // Helper Functions
    // =============================================================
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function uidUnchanged(userId) {
      return request.resource.data.uid == request.auth.uid &&
        request.resource.data.uid == userId;
    }

    function uidNotModified() {
      return request.resource.data.uid == resource.data.uid;
    }

    function isValidBirthday(value) {
      return value is string &&
        (value == '' || (value.size() == 10 && value.matches('^\\d{4}-\\d{2}-\\d{2}$')));
    }

    function isValidSettings(settings) {
      return settings is map &&
        settings.keys().hasAll([
          'theme',
          'recordReminder',
          'summaryQuality',
          'persona',
          'lunarCalendar',
          'fortuneBirthday'
        ]) &&
        settings.keys().hasOnly([
          'theme',
          'recordReminder',
          'summaryQuality',
          'persona',
          'lunarCalendar',
          'fortuneBirthday'
        ]) &&
        settings.theme is string && settings.theme in ['light', 'dark'] &&
        settings.recordReminder is bool &&
        settings.summaryQuality is string && settings.summaryQuality in ['표준', '고급', '최고'] &&
        settings.persona is string && settings.persona in ['따뜻한 공감형', '담백한 정리형'] &&
        settings.lunarCalendar is bool &&
        isValidBirthday(settings.fortuneBirthday);
    }

    function isValidUser(data, userId) {
      return data.keys().hasAll([
          'uid', 'email', 'displayName', 'settings', 'migrationVersion', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'uid', 'email', 'displayName', 'settings', 'migrationVersion', 'updatedAt'
        ]) &&
        data.uid is string && data.uid == userId && data.uid.size() > 0 && data.uid.size() <= 128 &&
        data.email is string && data.email.size() <= 254 &&
        data.displayName is string && data.displayName.size() > 0 && data.displayName.size() <= 80 &&
        isValidSettings(data.settings) &&
        data.migrationVersion is int && data.migrationVersion >= 0 && data.migrationVersion <= 1 &&
        data.updatedAt is timestamp && data.updatedAt == request.time;
    }

    function isValidDiary(data, userId) {
      return data.keys().hasAll([
          'uid', 'title', 'body', 'mood', 'summary', 'entryDate', 'createdAt', 'syncedAt', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'uid', 'title', 'body', 'mood', 'summary', 'entryDate', 'createdAt', 'syncedAt', 'updatedAt'
        ]) &&
        data.uid is string && data.uid == userId && data.uid.size() > 0 && data.uid.size() <= 128 &&
        data.title is string && data.title.size() > 0 && data.title.size() <= 200 &&
        data.body is string && data.body.size() > 0 && data.body.size() <= 200000 &&
        data.mood is string && data.mood.size() > 0 && data.mood.size() <= 50 &&
        data.summary is string && data.summary.size() <= 10000 &&
        data.entryDate is string && data.entryDate.size() == 10 &&
          data.entryDate.matches('^\\d{4}-\\d{2}-\\d{2}$') &&
        data.createdAt is timestamp &&
        data.syncedAt is timestamp && data.syncedAt == request.time &&
        data.updatedAt is timestamp && data.updatedAt == request.time;
    }

    match /users/{userId} {
      allow read: if isOwner(userId);
      allow create: if isOwner(userId) &&
        uidUnchanged(userId) &&
        isValidUser(request.resource.data, userId);
      allow update: if isOwner(userId) &&
        uidNotModified() &&
        uidUnchanged(userId) &&
        isValidUser(request.resource.data, userId);

      match /diaries/{diaryId} {
        allow read: if isOwner(userId) &&
          exists(/databases/$(database)/documents/users/$(userId));
        allow create: if isOwner(userId) &&
          exists(/databases/$(database)/documents/users/$(userId)) &&
          uidUnchanged(userId) &&
          isValidDiary(request.resource.data, userId);
        allow delete: if isOwner(userId) &&
          exists(/databases/$(database)/documents/users/$(userId)) &&
          resource.data.uid == userId;
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
